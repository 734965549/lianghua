# ===== 数据库 =====
LIANGHUA_DATABASE_URL=postgresql+psycopg://lianghua:lianghua_dev@127.0.0.1:5432/lianghua
# API、定时任务及数据修复共用的数据库连接池。默认最多 30 个连接。
LIANGHUA_DATABASE_POOL_SIZE=10
LIANGHUA_DATABASE_MAX_OVERFLOW=20
LIANGHUA_DATABASE_POOL_TIMEOUT_SECONDS=5
LIANGHUA_DATABASE_POOL_RECYCLE_SECONDS=1800
# pytest 专用库（勿与开发库同名）；留空则自动使用同主机的 lianghua_test
LIANGHUA_TEST_DATABASE_URL=postgresql+psycopg://lianghua:lianghua_dev@127.0.0.1:5432/lianghua_test

# ===== SDK =====
# mode: mock / real（MVP 阶段用 mock，真实接入前改 real）
LIANGHUA_SDK_MODE=mock
# driver: auto / sim / native（real 模式下 auto=路径未配则阻断，已配则走 native 占位）
LIANGHUA_SDK_DRIVER=auto
LIANGHUA_STOCK_SDK_PATH=C:/ths/stock_sdk
LIANGHUA_FUTURES_SDK_PATH=C:/ths/futures_sdk
LIANGHUA_STOCK_ACCOUNT=
LIANGHUA_FUTURES_ACCOUNT=

# ===== 真实交易 Broker =====
# broker_type: 空 / adapter / qmt / ptrade
# 默认空=adapter（基于 SDK Adapter）；qmt / ptrade 需安装 xtquant 或配置 RPC
LIANGHUA_BROKER_TYPE=
# QMT 本地直连
LIANGHUA_QMT_PATH=C:/qmt/client/xiadan
LIANGHUA_QMT_CLIENT_KEY=
LIANGHUA_QMT_ACCOUNT_ID=
LIANGHUA_QMT_RPC_URL=
LIANGHUA_QMT_POLL_SECONDS=1.0
# PTrade 本地直连
LIANGHUA_PTRADE_PATH=C:/ptrade/client/xiadan
LIANGHUA_PTRADE_CLIENT_KEY=
LIANGHUA_PTRADE_ACCOUNT_ID=
LIANGHUA_PTRADE_RPC_URL=
LIANGHUA_PTRADE_POLL_SECONDS=1.0


# ===== TqSdk 期货接入（天勤中继）=====
# 设 LIANGHUA_FUTURES_BROKER_TYPE=tqsdk 后使用下列配置。
# 免费版仅支持天勤指定期货公司；其他公司需专业版。
# TQSDK_BROKER_ID 为 TqSdk 期货公司标识（问客户经理确认），不要写死在代码里。
LIANGHUA_FUTURES_BROKER_TYPE=
LIANGHUA_TQSDK_BROKER_ID=
LIANGHUA_TQSDK_ACCOUNT_ID=
LIANGHUA_TQSDK_PASSWORD=
LIANGHUA_TQSDK_AUTH_USER=
LIANGHUA_TQSDK_AUTH_PASSWORD=
LIANGHUA_TQSDK_LIVE_ENABLED=false
LIANGHUA_TQSDK_LIVE_ARM_TOKEN=
LIANGHUA_TQSDK_COMMAND_TIMEOUT_SECONDS=10
LIANGHUA_TQSDK_COMMAND_QUEUE_SIZE=1000
LIANGHUA_TQSDK_RECONNECT_MAX_SECONDS=60

# ===== 行情源 =====
# quote_provider: mock / akshare / tdx / ifind / tushare_pro / rqdata / wind / tqsdk
# 推荐按市场拆分；未设置时回退 LIANGHUA_QUOTE_PROVIDER
# 默认 mock；切换专业数据源需填写对应 token/账号
LIANGHUA_QUOTE_PROVIDER=mock
# 推荐拆分：股票 akshare，期货 tqsdk（仅需快期账号，与实盘资金账户无关）
LIANGHUA_STOCK_QUOTE_PROVIDER=
LIANGHUA_FUTURES_QUOTE_PROVIDER=
# LIANGHUA_STOCK_QUOTE_PROVIDER=akshare
# LIANGHUA_FUTURES_QUOTE_PROVIDER=tqsdk
LIANGHUA_AKSHARE_POLL_SECONDS=10.0

# 通达信 TdxQuant 官方本地 HTTP 接口（需先启动支持 TQ 的通达信客户端）
LIANGHUA_TDX_ENDPOINT=http://127.0.0.1:17709/
LIANGHUA_TDX_POLL_SECONDS=3.0

# 同花顺 iFinD 数据接口（实时行情）
# Python 组件：pip install iFinDAPI
LIANGHUA_IFIND_USERNAME=
LIANGHUA_IFIND_PASSWORD=
LIANGHUA_IFIND_POLL_SECONDS=3.0

# Tushare Pro（https://tushare.pro）
LIANGHUA_TUSHARE_TOKEN=
LIANGHUA_TUSHARE_POLL_SECONDS=10.0

# RQData（https://www.ricequant.com/welcome/rqdata）
LIANGHUA_RQDATA_USERNAME=
LIANGHUA_RQDATA_PASSWORD=
LIANGHUA_RQDATA_POLL_SECONDS=5.0

# Wind（需本地安装 Wind 终端并注册 WindPy）
LIANGHUA_WIND_POLL_SECONDS=5.0

# ===== 安全 =====
# 敏感字段加密密钥，32 字节随机串的 base64
# 生成：python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
LIANGHUA_CONFIG_KEY=

# ===== AI（可选，留空走规则化模板）=====
LIANGHUA_AI_PROVIDER=
LIANGHUA_AI_API_KEY=
LIANGHUA_AI_BASE_URL=
LIANGHUA_AI_MODEL=gpt-4o-mini

# ===== 运行 =====
LIANGHUA_HOST=127.0.0.1
LIANGHUA_PORT=8000
LIANGHUA_LOG_LEVEL=INFO
LIANGHUA_BACKUP_DIR=./backups
LIANGHUA_TZ=Asia/Shanghai
# 交易日由 exchange-calendars 的 XSHG 离线日历提供；以下仅用于追加临时休市日。
# 服务启动时会校验当前完整年度是否在内置日历覆盖范围内，未覆盖则拒绝启动。
# ISO 日期逗号分隔；股票、期货可分别追加。
LIANGHUA_STOCK_MARKET_HOLIDAYS=
LIANGHUA_FUTURES_MARKET_HOLIDAYS=
# 环境：dev / production；production 时错误响应不返回 debug 字段
LIANGHUA_APP_ENV=dev
