# ===== 数据库 =====
LIANGHUA_DATABASE_URL=postgresql+psycopg://lianghua:lianghua_dev@127.0.0.1:5432/lianghua
# pytest 专用库（勿与开发库同名）；留空则自动使用同主机的 lianghua_test
LIANGHUA_TEST_DATABASE_URL=postgresql+psycopg://lianghua:lianghua_dev@127.0.0.1:5432/lianghua_test

# ===== SDK =====
# mode: mock / real（MVP 阶段用 mock，真实接入前改 real）
LIANGHUA_SDK_MODE=mock
# driver: auto / sim / native（real 模式下 auto=路径未配则阻断，已配则走 native 占位）
LIANGHUA_SDK_DRIVER=auto
LIANGHUA_STOCK_SDK_PATH=C:/ths/stock_sdk
LIANGHUA_FUTURES_SDK_PATH=C:/ths/futures_sdk
LIANGHUA_STOCK_ACCOUNT=
LIANGHUA_FUTURES_ACCOUNT=

# ===== 行情源 =====
# quote_provider: mock / akshare / ths
# 默认 mock，切换 akshare 需确保源站可用（否则 connect 后 get_quote 可能失败）
LIANGHUA_QUOTE_PROVIDER=mock
LIANGHUA_AKSHARE_POLL_SECONDS=10.0

# ===== 安全 =====
# 敏感字段加密密钥，32 字节随机串的 base64
# 生成：python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
LIANGHUA_CONFIG_KEY=

# ===== AI（可选，留空走规则化模板）=====
LIANGHUA_AI_PROVIDER=
LIANGHUA_AI_API_KEY=
LIANGHUA_AI_BASE_URL=
LIANGHUA_AI_MODEL=gpt-4o-mini

# ===== 运行 =====
LIANGHUA_HOST=127.0.0.1
LIANGHUA_PORT=8000
LIANGHUA_LOG_LEVEL=INFO
LIANGHUA_BACKUP_DIR=./backups
LIANGHUA_TZ=Asia/Shanghai
# 环境：dev / production；production 时错误响应不返回 debug 字段
LIANGHUA_APP_ENV=dev
